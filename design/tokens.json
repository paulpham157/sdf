  "semantic": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.cream-100}",
        "$description": "Page background."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.cream-100}",
        "$description": "Flat regions on the page. Same value as bg today."
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{color.cream-50}",
        "$description": "Cards, panels, graph nodes."
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.cream-200}",
        "$description": "Wells, code blocks, progress tracks."
      },
      "text": {
        "$type": "color",
        "$value": "{color.charcoal-900}"
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.charcoal-700}"
      },
      "text-inverse": {
        "$type": "color",
        "$value": "{color.cream-100}",
        "$description": "Text on charcoal fills (selected pills, chosen nodes)."
      },
      "text-inverse-muted": {
        "$type": "color",
        "$value": "{color.cream-400}"
      },
      "surface-inverse": {
        "$type": "color",
        "$value": "{color.charcoal-900}",
        "$description": "Charcoal bands (landing close section, selected pills)."
      },
      "border": {
        "$type": "color",
        "$value": "{color.cream-400}",
        "$description": "Decorative dividers only. Not a component boundary."
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.charcoal-500}",
        "$description": "Component boundaries, inputs, axes. At least 3:1."
      },
      "accent": {
        "$type": "color",
        "$value": "{color.rust-500}",
        "$description": "Rust. Fills, strokes, rules, chosen state. Not small text."
      },
      "accent-soft": {
        "$type": "color",
        "$value": "{color.rust-100}",
        "$description": "Tinted background for an accent state."
      },
      "accent-text": {
        "$type": "color",
        "$value": "{color.rust-700}",
        "$description": "Rust that is safe for text and links (at least 4.5:1)."
      },
      "link": {
        "$type": "color",
        "$value": "{color.accent-text}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.rust-500}",
        "$description": "2px outline, 2px offset, drawn on the surface."
      },
      "accent-on-inverse": {
        "$type": "color",
        "$value": "{color.rust-200}",
        "$description": "Rust that reads on charcoal: kickers, rules, links on surface-inverse."
      },
      "focus-on-inverse": {
        "$type": "color",
        "$value": "{color.rust-200}",
        "$description": "Focus ring on charcoal; rust-500 is only 2.85:1 there."
      },
      "success": {
        "$type": "color",
        "$value": "{color.green-700}"
      },
      "success-soft": {
        "$type": "color",
        "$value": "{color.green-50}"
      },
      "warning": {
        "$type": "color",
        "$value": "{color.amber-700}"
      },
      "warning-soft": {
        "$type": "color",
        "$value": "{color.amber-50}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.red-700}",
        "$description": "Crimson, kept apart from rust so an error never reads as the chosen path."
      },
      "error-soft": {
        "$type": "color",
        "$value": "{color.red-50}"
      },
      "info": {
        "$type": "color",
        "$value": "{color.blue-700}"
      },
      "info-soft": {
        "$type": "color",
        "$value": "{color.blue-50}"
      }
    },
    "graph": {
      "node-fill": {
        "$type": "color",
        "$value": "{color.surface-raised}"
      },
      "node-stroke": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "node-text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "chosen": {
        "$type": "color",
        "$value": "{color.accent}",
        "$description": "Chosen path: edges and the outline of on-path nodes (the rust thread)."
      },
      "chosen-fill": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "On-path decision fill; text uses text-inverse."
      },
      "not-taken": {
        "$type": "color",
        "$value": "{color.charcoal-500}",
        "$description": "Dashed stroke for alternatives not taken."
      },
      "future": {
        "$type": "color",
        "$value": "{color.charcoal-400}",
        "$description": "Replay nodes and ticks not reached yet. Dashed, no fill. Was #b9b0a0 (1.87:1)."
      },
      "edge": {
        "$type": "color",
        "$value": "{color.charcoal-500}"
      },
      "refinement": {
        "$type": "color",
        "$value": "{color.violet-700}"
      },
      "refinement-soft": {
        "$type": "color",
        "$value": "{color.violet-50}"
      },
      "conflict": {
        "$type": "color",
        "$value": "{color.error}",
        "$description": "Paired with the crack dash pattern; never color alone."
      },
      "unknown": {
        "$type": "color",
        "$value": "{color.warning}",
        "$description": "Unknown and locked; locked adds the hatch."
      },
      "hatch-bg": {
        "$type": "color",
        "$value": "{color.amber-50}"
      },
      "hatch-line": {
        "$type": "color",
        "$value": "{color.amber-200}"
      },
      "ending": {
        "$type": "color",
        "$value": "{color.success}"
      },
      "ending-soft": {
        "$type": "color",
        "$value": "{color.success-soft}"
      },
      "muted-fill": {
        "$type": "color",
        "$value": "{color.surface-sunken}"
      },
      "muted-stroke": {
        "$type": "color",
        "$value": "{color.charcoal-400}"
      },
      "muted-text": {
        "$type": "color",
        "$value": "{color.text}"
      },
      "track": {
        "$type": "color",
        "$value": "{color.charcoal-400}",
        "$description": "Replay track base."
      }
    },
    "chart": {
      "series-1": {
        "$type": "color",
        "$value": "{color.charcoal-700}",
        "$description": "Primary volume: bars (sessions, unlinked commits)."
      },
      "series-2": {
        "$type": "color",
        "$value": "{color.rust-500}",
        "$description": "Second series or the line over bars (cost, unlinked decisions)."
