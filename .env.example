# Live full loop: public POST /tasks/{id}/run through a sandboxed agent (#46)
#
# Not claimed: production readiness, real customer repositories, multi-agent
# routing. Default CI stays FakeNativeAdapter.
#
# Gate the live HTTP proof with either flag plus E2B_API_KEY and a model key.
# The example gate still looks for VULTR_INFERENCE_API_KEY (an example key
# name for the example OpenAI-compatible endpoint, not a protocol — ADR 0034):
#   SDF_LIVE_FULL_LOOP=1
#   # or reuse: SDF_LIVE_E2B=1
#
# Public run path (API process) — Fake unless set (ADR 0023):
SDF_RUN_ADAPTER=fake
# SDF_RUN_ADAPTER=live
# SDF_RUN_AGENT=codex            # codex|claude|opencode|pi|qwen|goose
#   OpenAI-family kinds default to the example OpenAI-compatible endpoint.
#   claude with no base URL uses https://api.anthropic.com (Messages API).
#   codex requires a host that implements the OpenAI Responses API.
# SDF_SANDBOX_PROVIDER=e2b       # daytona also needs SDF_RUN_DAYTONA_UNRESTRICTED_EGRESS=1
# SDF_E2B_AGENTS_TEMPLATE=       # default: agent_sandbox.DEFAULT_TEMPLATE
# SDF_CODEX_MODEL=glm-5.3        # SDF_HERDR_CODEX_MODEL is a deprecated alias
# SDF_RUN_EGRESS_ALLOW=          # extra egress hosts; default is the resolved LLM host only
# SDF_FIXTURES_ROOT=./fixtures
# Evaluator checks (ADR 0025): /run takes check ids, resolved from <fixture>/sdf-checks.json
# and/or this server file. off|prefer|require runs checks without/with the containment backend;
# unset = require for live agents (SDF_RUN_ADAPTER=live, plan runs), off for the fake adapter.
# SDF_EVALUATOR_CHECKS_FILE=
# SDF_EVALUATOR_CONTAINMENT=require

# Plan-run prices used for max_cost_usd (server-set; callers cannot override).
# Must be finite and >= 0; an invalid value makes /plans/{id}/runs return 503.
# SDF_RUN_PRICE_IN_PER_M=0.75
# SDF_RUN_PRICE_OUT_PER_M=3.0
# SDF_RUN_SANDBOX_USD_PER_S=0.000056
# SDF_RUN_MAX_CONCURRENT=2
# SDF_HERDR_TIMEOUT_MS=240000
# SDF_RUN_TURN_TIMEOUT_S=420
# SDF_E2B_SANDBOX_TIMEOUT_SECONDS=900
# SDF_LOG_FORMAT=json
# SDF_LOG_LEVEL=INFO
# Tracing (ADR 0024, docs/tracing.md): off unless SDF_OTEL_ENABLED=1; needs `sdf[otel]`.
# SDF_OTEL_ENABLED=0
# SDF_OTEL_EXPORTER=otlp         # otlp | console
# SDF_OTEL_DB=0                  # SQLAlchemy spans (no bound values)
# OTEL_SERVICE_NAME=sdf-core
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=    # backend auth; never logged or put on spans
# OTEL_TRACES_SAMPLER=parentbased_always_on
# daytona is owned by #44 and is rejected here until that work merges.

# Copy to .env (git-ignored) and fill in values. Real environment variables win over .env.
E2B_DOMAIN=e2b.dev
# E2B_API_KEY=<paste the matching key here>

# Sandbox provider for the persistent Herdr transport (default e2b).
# SDF_SANDBOX_PROVIDER=e2b

# Daytona (optional alternative to E2B for the persistent Herdr transport).
# DAYTONA_API_KEY=<paste the matching key here>
# DAYTONA_API_URL=
# DAYTONA_TARGET=us
# SDF_DAYTONA_SNAPSHOT=daytona-small
# Live Daytona unit/smoke: SDF_LIVE_DAYTONA=1 (never commit the key)

# Credential Mode per agent kind (required when that agent starts): subscription | api-key
# No default and no fallback between modes (ADR-0007).
SDF_CREDENTIAL_MODE_CLAUDE=
SDF_CREDENTIAL_MODE_CODEX=
# OpenCode supports api-key only (ADR-0011).
SDF_CREDENTIAL_MODE_OPENCODE=
# Pi supports api-key only (ADR-0012).
SDF_CREDENTIAL_MODE_PI=
# Qwen Code and Goose support api-key only (ADR-0013).
SDF_CREDENTIAL_MODE_QWEN=
SDF_CREDENTIAL_MODE_GOOSE=

# subscription mode: herdr-e2b plugin connection id (see `e2b-box auth connect <agent>`)
SDF_CONNECTION_CLAUDE=
SDF_CONNECTION_CODEX=

# api-key mode: dedicated SDF_* keys. The shell's ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL,
# OPENAI_API_KEY and OPENAI_BASE_URL are always ignored.
SDF_ANTHROPIC_API_KEY=
SDF_OPENAI_API_KEY=
SDF_OPENCODE_API_KEY=
# Pi (ADR-0012). The seeded ~/.pi/agent/models.json stores only the key
# variable's NAME as apiKey, never the value.
SDF_PI_API_KEY=
# Qwen Code / Goose (ADR-0013): seeds store only the key variable's NAME.
SDF_QWEN_API_KEY=
SDF_GOOSE_API_KEY=

# api-key mode only, optional: read the key from a differently named variable
# instead (never in addition). The name must end in _API_KEY (ADR-0011).
# Any dedicated *_API_KEY name works. VULTR_INFERENCE_API_KEY is only an example.
# Example: SDF_OPENCODE_API_KEY_ENV=GATEWAY_API_KEY (same for SDF_PI/QWEN/GOOSE/CODEX/CLAUDE_API_KEY_ENV)
SDF_CLAUDE_API_KEY_ENV=
SDF_CODEX_API_KEY_ENV=
SDF_OPENCODE_API_KEY_ENV=
SDF_PI_API_KEY_ENV=
SDF_QWEN_API_KEY_ENV=
SDF_GOOSE_API_KEY_ENV=

# api-key mode only, optional: OpenAI-compatible or Claude Messages endpoint.
# Must be https and publicly reachable (no localhost, loopback, link-local or private addresses).
# The host is not a protocol (ADR 0034). Codex's host must implement the OpenAI
# Responses API (POST /v1/responses), not Chat Completions only.
# Unset Claude uses https://api.anthropic.com. Headless kinds (opencode, pi,
# qwen, goose) default to the example OpenAI-compatible endpoint
# https://api.vultrinference.com/v1. Unset /run Codex uses that example URL
# only when the key variable is VULTR_INFERENCE_API_KEY; SDF_OPENAI_API_KEY
# or any other *_API_KEY_ENV stays on https://api.openai.com/v1 (Responses).
SDF_ANTHROPIC_BASE_URL=
SDF_OPENAI_BASE_URL=
# OpenCode example default (OpenAI-compatible): https://api.vultrinference.com/v1
SDF_OPENCODE_BASE_URL=
# Pi example default is the same OpenAI-compatible URL
SDF_PI_BASE_URL=
# Qwen Code / Goose example default is the same OpenAI-compatible URL
SDF_QWEN_BASE_URL=
SDF_GOOSE_BASE_URL=

# Optional model per agent kind; unset keeps the CLI default (Claude, and Codex
# unless the key variable is VULTR_INFERENCE_API_KEY with no base URL, which
# sets the example model glm-5.3).
# Claude/Codex: applied only where the caller passes
# sdf_core.agent_models.model_agent_args(...) as HerdrRuntime(agent_args=...).
# OpenCode: written into the seeded config at sandbox creation.
# OpenCode needs <local provider id>/<model>; main and small model share one id.
# The example id "vultr" is the seeded provider entry, not an API family.
# Defaults: SDF_OPENCODE_MODEL=vultr/glm-5.3, SDF_OPENCODE_SMALL_MODEL=vultr/glm-5.3-flash
SDF_CLAUDE_MODEL=
SDF_CODEX_MODEL=
SDF_OPENCODE_MODEL=
SDF_OPENCODE_SMALL_MODEL=
# Pi: bare model id without ':' (default glm-5.3)
SDF_PI_MODEL=
# Pi extensions baked into sdf-herdr-agents (ADR-0017), comma-separated.
# Unset: both of @cad0p/pi-steering,@paulpham157/apply-patch (pi-fabric, pi-lens rejected).
# Empty: none (needed on templates without /opt/sdf-pi-extensions).
# Read-only Pi turns load only @cad0p/pi-steering. Nothing is installed at runtime.
# SDF_PI_EXTENSIONS=
# Qwen Code / Goose: bare model id (default glm-5.3)
SDF_QWEN_MODEL=
SDF_GOOSE_MODEL=

# Live OpenCode loop: SDF_LIVE_E2B=1 SDF_LIVE_OPENCODE=1 (+ E2B_API_KEY and the OpenCode key)
# SDF_E2B_OPENCODE_TEMPLATE=opencode
# Live agents on the example OpenAI-compatible endpoint (historical gate names):
# SDF_LIVE_E2B=1 SDF_LIVE_VULTR_AGENTS=1|codex,claude,pi,qwen,goose
# (example key name VULTR_INFERENCE_API_KEY; prebuilt image SDF_E2B_VULTR_TEMPLATE,
# default sdf-herdr-agents; SDF_E2B_VULTR_BASE_TEMPLATE=codex bootstraps a bare base.
# Claude on that host needs SDF_ANTHROPIC_BASE_URL; Codex needs Responses.)

# Multi-agent runs (ADR 0014)
# 1 = /tasks/{id}/run also refuses tasks that belong to no human-approved plan.
SDF_REQUIRE_PLAN_APPROVAL=
# e2b = POST /plans/{id}/runs starts agents in E2B (template sdf-herdr-agents,
# egress is the configured LLM host, no public traffic); unset = 503.
SDF_AGENT_SANDBOX=
# Host-side scratch for collected workspaces and Artifacts.
SDF_WORKSPACE_ROOT=.sdf-workspaces
SDF_ARTIFACT_ROOT=.sdf-artifacts
# Run agents read their key from SDF_<KIND>_API_KEY or SDF_<KIND>_API_KEY_ENV.
# If neither is set, the example name VULTR_INFERENCE_API_KEY is selected.
# That name is not a protocol (ADR 0034).
# Live E2E: SDF_LIVE_E2B=1 SDF_LIVE_AGENT_COMM=1 uv run pytest tests/test_agent_comm_live.py
# (optional SDF_LIVE_LEAD_KIND / SDF_LIVE_WORKER_KIND: opencode or pi)

# API authentication (ADR 0015) - names only; generate your own values.
# Required: 32+ random characters (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))").
SDF_AUTH_PEPPER=
# 1 = a solo user may approve their own plans (recorded as self_approval).
SDF_AUTH_SINGLE_USER=
# 1 = local development only: header-less requests from 127.0.0.1 act as admin "local-dev".
SDF_AUTH_DEV_INSECURE=
# Lockout after repeated failed authentications (defaults 10 / 300 s / 300 s).
SDF_AUTH_MAX_FAILURES=
SDF_AUTH_FAILURE_WINDOW_S=
SDF_AUTH_LOCKOUT_S=
