# Copy to .env (git-ignored) and fill in values. Real environment variables win over .env.
E2B_DOMAIN=e2b.dev
# E2B_API_KEY=<paste the matching key here>

# Sandbox provider for the persistent Herdr transport (default e2b).
# SDF_SANDBOX_PROVIDER=e2b|daytona
# SDF_SANDBOX_PROVIDER=e2b

# Daytona (optional alternative to E2B for the persistent Herdr transport).
# DAYTONA_API_KEY=<paste the matching key here>
# DAYTONA_API_URL=
# DAYTONA_TARGET=us
# SDF_DAYTONA_SNAPSHOT=daytona-small
# Live Daytona unit/smoke: SDF_LIVE_DAYTONA=1 (never commit the key)

# Credential Mode per agent kind (required when that agent starts): subscription | api-key
# No default and no fallback between modes (ADR-0007).
SDF_CREDENTIAL_MODE_CLAUDE=
SDF_CREDENTIAL_MODE_CODEX=

# subscription mode: herdr-e2b plugin connection id (see `e2b-box auth connect <agent>`)
SDF_CONNECTION_CLAUDE=
SDF_CONNECTION_CODEX=

# api-key mode: dedicated SDF_* keys. The shell's ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL,
# OPENAI_API_KEY and OPENAI_BASE_URL are always ignored.
SDF_ANTHROPIC_API_KEY=
SDF_OPENAI_API_KEY=

# api-key mode only, optional: custom provider endpoint. Unset means the provider default.
# Must be https and publicly reachable (no localhost, loopback, link-local or private addresses).
SDF_ANTHROPIC_BASE_URL=
SDF_OPENAI_BASE_URL=
